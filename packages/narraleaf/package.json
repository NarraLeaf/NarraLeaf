{
  "name": "narraleaf",
  "version": "0.1.0-alpha.2",
  "description": "Create your visual novel with Electron and React",
  "bin": "./dist/cli.cjs",
  "main": "dist/index.mjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "license": "MPL-2.0",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./renderer": {
      "import": "./dist/renderer.mjs",
      "types": "./dist/renderer.d.ts"
    },
    "./main": {
      "import": "./dist/index.mjs",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "rimraf dist && node build.js && tsc --emitDeclarationOnly && tsc-alias",
    "build:dev": "node build.js --dev && tsc --emitDeclarationOnly && tsc-alias",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "react",
    "electron",
    "visual-novel",
    "typescript",
    "narraleaf",
    "nvl"
  ],
  "dependencies": {
    "@emotion/is-prop-valid": "^1.3.1",
    "@narraleaf/shared": "0.1.0-alpha.2",
    "lodash": "^4.17.21",
    "mime-types": "^2.1.35",
    "motion": "^11.15.10",
    "msgpack-lite": "^0.1.26",
    "ws": "^8.18.1"
  },
  "peerDependencies": {
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8",
    "narraleaf-react": "^0.8.6",
    "react": "^19",
    "react-dom": "^19"
  },
  "devDependencies": {
    "@types/lodash": "^4.17.15",
    "@types/mime-types": "^2",
    "@types/msgpack-lite": "^0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.10",
    "@types/webpack-node-externals": "^3",
    "@types/ws": "^8",
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8",
    "esbuild": "0.25.0",
    "esbuild-css-modules-plugin": "^3.1.4",
    "narraleaf-react": "^0.8.6",
    "tsc-alias": "^1.8.10",
    "webpack-node-externals": "^3.0.0"
  },
  "files": [
    "dist"
  ]
}
